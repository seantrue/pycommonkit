  "darwin": {
   "max_bytes": 2147483648,
   "ttl_s": 900.0,
   "reap_interval_s": 30.0,
   "min_free_bytes": 8589934592,
   "max_array_bytes": 134217728
  },
  "linux": {
   "max_bytes": 8589934592,
   "ttl_s": 900.0,
   "reap_interval_s": 30.0,
   "min_free_bytes": 8589934592,
   "max_array_bytes": 134217728
  }
 },
